# AI Meeting Assistant — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
#
# SUPABASE_SERVICE_ROLE_KEY is server-only — NEVER prefix with NEXT_PUBLIC_
# Generate NEXTAUTH_SECRET: openssl rand -base64 32

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NextAuth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
# Set to your domain in production
NEXTAUTH_URL=http://localhost:3000

# ── AssemblyAI (speech-to-text) ───────────────────────────
ASSEMBLYAI_API_KEY=your-assemblyai-key

# ── OpenRouter (AI analysis) ─────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key
# Optional — override the default AI model
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ── WAHA (WhatsApp) — optional ────────────────────────────
WAHA_API_URL=http://your-waha-host:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
